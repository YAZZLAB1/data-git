# Finance OS configuration. Copy to .env.local and adjust.

# PostgreSQL connection string. Works with any PostgreSQL 15+ server, including
# a Supabase project's database (Project settings -> Database -> Connection string).
# Leave empty to use the embedded PostgreSQL (PGlite) stored in ./.data/pglite,
# which is ideal for local, single-user use.
# On Vercel, STORAGE_DATABASE_URL / POSTGRES_URL (set by its Neon integration) also work.
DATABASE_URL=

# Directory for the embedded database when DATABASE_URL is empty.
PGLITE_DATA_DIR=./.data/pglite

# Set to "true" when serving over HTTPS so session cookies get the Secure flag.
# Defaults to true when NODE_ENV=production.
COOKIE_SECURE=
